{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hitch.dev/schemas/hitch-tree-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "const": "hitch-tree@1"
    },
    "entries": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*[\\\\\\u0000-\\u001f\\u007f:])(?!.*//)(?!.*[/ ]$).+"
              },
              "kind": {
                "const": "directory"
              }
            },
            "required": [
              "path",
              "kind"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*[\\\\\\u0000-\\u001f\\u007f:])(?!.*//)(?!.*[/ ]$).+"
              },
              "kind": {
                "const": "file"
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "executable": {
                "type": "boolean"
              }
            },
            "required": [
              "path",
              "kind",
              "digest",
              "size",
              "executable"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "protocol",
    "entries"
  ]
}
