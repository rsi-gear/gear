+import test, { type TestContext } from "node:test";
+import assert from "node:assert/strict";
+import http from "node:http";
+import { once } from "node:events";
+import { spawn } from "node:child_process";
+import { mkdtemp, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import { HostModelProxy, parseTrainingBinding, trainingProxyIdentity } from "../src/model-access/index.js";
+import { packageRoot } from "../src/foundation/index.js";
+import { trainingHarborIdentity } from "../src/runs/training-runtime.js";
+
+// Real runner and run-scoped proxy; the model response is an HTTP fixture.
+// This does not represent a Harbor container, GPU update, or quality experiment.
+async function fixture(t: TestContext) {
+  const hash = `sha256:${"a".repeat(64)}` as const, runId = `run_${"c".repeat(32)}`;
+  const binding = parseTrainingBinding({ kind: "training-external", bindingId: "text_test", trainingRunId: "train_text",
+    policyLeaseRef: { uri: `cas:${hash}`, digest: hash, mediaType: "application/json" }, expectedPolicyVersion: "runtime-1/update-0",
+    fencingToken: "fixture-fence", expiresAt: new Date(Date.now() + 60_000).toISOString(), endpointRef: "hitch-training:text_test",
+    credentialRef: "hitch-training:text_test", generationContractDigest: hash, requiredCapture: "exact-policy-tokens-v1",
+    api: "chat-completions", maxOutputTokens: 16, maxEpisodeSteps: 4 });
+  const calls: { url: string; headers: http.IncomingHttpHeaders; body: Record<string, any> }[] = [];
+  const state = { status: 200, hold: false, choice: { finish_reason: "stop", message: { role: "assistant", content: "\\boxed{2}" } } as Record<string, unknown> };
+  let started!: () => void;
+  const generationStarted = new Promise<void>(resolve => { started = resolve; });
+  const server = http.createServer(async (req, res) => {
+    let raw = ""; for await (const chunk of req) raw += chunk;
+    const body = JSON.parse(raw); calls.push({ url: req.url!, headers: req.headers, body });
+    res.setHeader("content-type", "application/json");
+    if (req.url === "/v1/hitch/run") { res.end(JSON.stringify({ runId: body.runId, policyVersion: binding.expectedPolicyVersion })); return; }
+    started();
+    if (state.hold) return;
+    res.statusCode = state.status; res.setHeader("x-gear-receipt-id", "receipt-text-0");
+    res.end(JSON.stringify({ model: binding.expectedPolicyVersion, choices: [state.choice], usage: { prompt_tokens: 10, completion_tokens: 4 } }));
+  });
+  const root = await mkdtemp(path.join(tmpdir(), "hitch-model-call-training-"));
+  let proxy: HostModelProxy | undefined;
+  const children: ReturnType<typeof spawn>[] = [];
+  t.after(async () => {
+    for (const child of children) if (child.exitCode === null && child.signalCode === null) child.kill("SIGKILL");
+    await proxy?.close(); server.closeAllConnections();
+    await new Promise<void>(resolve => server.close(() => resolve()));
+    await rm(root, { recursive: true, force: true });
+  });
+  server.listen(0, "127.0.0.1"); await once(server, "listening");
+  const upstream = `http://127.0.0.1:${(server.address() as import("node:net").AddressInfo).port}/v1`;
+  const credential = "s".repeat(48);
+  proxy = await HostModelProxy.start({ captureRoot: root, evalId: `eval_${"b".repeat(32)}`, mode: "proxy", required: true,
+    trainingEndpoint: { schema_version: "1", binding, base_url: upstream, credential }, upstreams: { openai: upstream },
+    upstreamAuthorizations: { openai: `Bearer ${credential}` }, upstreamWireModels: { openai: binding.expectedPolicyVersion },
+    credentialValues: [credential], bindHost: "127.0.0.1", advertisedHost: "127.0.0.1" });
+  const env: NodeJS.ProcessEnv = { PATH: process.env.PATH, HITCH_HARBOR_INTERNAL: "1", HITCH_TRAINING_EXTERNAL: "1",
+    HITCH_TRAINING_RUN_ID: runId, HITCH_TRAINING_BINDING: JSON.stringify(trainingProxyIdentity(binding)),
+    OPENAI_API_KEY: "hitch-training-external", OPENAI_BASE_URL: `${proxy.localBaseUrl}/${runId}/openai` };
+  function launch(input: unknown = "Compute 1 + 1.", overrides: NodeJS.ProcessEnv = {}) {
+    const child = spawn(process.execPath, [path.join(packageRoot(), "integrations/model-call/cli.js"), "--model", "training/text_test"],
+      { env: { ...env, ...overrides }, stdio: ["pipe", "pipe", "pipe"] });
+    children.push(child);
+    let stdout = "", stderr = "";
+    child.stdout!.on("data", c => stdout += c); child.stderr!.on("data", c => stderr += c);
+    const done = once(child, "close").then(([code]) => ({ code, stderr,
+      events: stdout.trim().split("\n").filter(Boolean).map(line => JSON.parse(line)) }));
+    child.stdin!.end(typeof input === "string" ? input : JSON.stringify(input));
+    return { child, done };
+  }
+  return { env, runId, binding, calls, state, launch, generationStarted };
+}
+
+test("training model-call preserves one tool-free text request through the native proxy", async t => {
+  const f = await fixture(t);
+  const input = { schema_version: "1", messages: [
+    { role: "system", content: [{ type: "input_text", text: "Solve and box the answer." }] },
+    { role: "user", content: [{ type: "input_text", text: "Compute 1 + 1." }] },
+  ] };
+  const result = await f.launch(input, { HITCH_MODEL_API: "responses", HITCH_LOCAL_MAX_OUTPUT_TOKENS: "99",
+    HITCH_LOCAL_MODEL_BASE_URL: "https://unused.invalid", HITCH_LOCAL_MODEL_TOKEN: "unused" }).done;
+  assert.equal(result.code, 0, result.stderr);
+  assert.deepEqual(f.calls.map(c => c.url), ["/v1/hitch/run", "/v1/chat/completions"]);
+  const call = f.calls[1]!;
+  assert.equal(call.headers.authorization, `Bearer ${"s".repeat(48)}`);
+  assert.equal(call.headers["idempotency-key"], `${f.runId}-0`);
+  assert.deepEqual(call.body, { model: f.binding.expectedPolicyVersion, messages: [
+    { role: "system", content: "Solve and box the answer." }, { role: "user", content: "Compute 1 + 1." },
+  ], max_tokens: 16, stream: false });
+  assert.equal(result.events.find(e => e.type === "provider.response").receipt_id, "receipt-text-0");
+  assert.deepEqual(result.events.filter(e => e.type === "training.terminated"), [{ type: "training.terminated", termination: "terminated" }]);
+  assert.equal(result.events.find(e => e.type === "message.completed").text, "\\boxed{2}");
+  assert.deepEqual(trainingHarborIdentity(f.env, f.runId, "training/text_test", `model-call@commit:${"d".repeat(40)}`), trainingProxyIdentity(f.binding));
+  assert.throws(() => trainingHarborIdentity(f.env, f.runId, "training/text_test", `codex@commit:${"d".repeat(40)}`), /binding is invalid/);
+});
+
+test("training model-call rejects unbound, overridden, multi-turn and image inputs before generation", async t => {
+  const f = await fixture(t);
+  const user = { role: "user", content: [{ type: "input_text", text: "question" }] };
+  const input = { schema_version: "1", messages: [user] };
+  for (const [value, env] of [
+    [input, { HITCH_HARBOR_INTERNAL: "0" }], [input, { HITCH_TRAINING_EXTERNAL: "0" }],
+    [input, { OPENAI_BASE_URL: "http://127.0.0.1:1/v1" }],
+    [{ ...input, max_output_tokens: 99 }, {}], [{ ...input, reasoning_effort: "high" }, {}],
+    [{ ...input, messages: [user, user] }, {}],
+    [{ ...input, messages: [{ role: "user", content: [{ type: "input_image", image_url: "data:image/png;base64,aGVsbG8=" }] }] }, {}],
+  ] as [unknown, NodeJS.ProcessEnv][]) assert.notEqual((await f.launch(value, env).done).code, 0);
+  assert.equal(f.calls.length, 0);
+});
+
+test("training model-call marks length separately without a completed answer or retry", async t => {
+  const f = await fixture(t); f.state.choice.finish_reason = "length";
+  const result = await f.launch().done;
+  assert.equal(result.code, 8, result.stderr);
+  assert.deepEqual(result.events.filter(e => e.type === "training.terminated"), [{ type: "training.terminated", termination: "truncated" }]);
+  assert.equal(result.events.some(e => e.type === "message.completed"), false);
+  assert.equal(f.calls.filter(c => c.url === "/v1/chat/completions").length, 1);
+});
+
+test("training model-call rejects tool completions without emitting a normal terminal sample", async t => {
+  const f = await fixture(t);
+  f.state.choice = { finish_reason: "tool_calls", message: { role: "assistant", content: null,
+    tool_calls: [{ id: "tool-0", type: "function", function: { name: "bash", arguments: "{}" } }] } };
+  const result = await f.launch().done;
+  assert.notEqual(result.code, 0); assert.match(result.stderr, /invalid training text completion/);
+  assert.equal(result.events.some(e => e.type === "training.terminated"), false);
+  assert.equal(f.calls.filter(c => c.url === "/v1/chat/completions").length, 1);
+});
+
+test("training model-call never retries an upstream HTTP failure", async t => {
+  const f = await fixture(t); f.state.status = 503;
+  const result = await f.launch().done;
+  assert.notEqual(result.code, 0); assert.match(result.stderr, /HTTP 503/);
+  assert.equal(result.events.some(e => e.type === "training.terminated"), false);
+  assert.equal(f.calls.filter(c => c.url === "/v1/chat/completions").length, 1);
+});
+
+test("training model-call cancellation exits without publishing success", { timeout: 10_000 }, async t => {
+  const f = await fixture(t); f.state.hold = true;
+  const { child, done } = f.launch(); await f.generationStarted; child.kill("SIGTERM");
+  const result = await done;
+  assert.notEqual(result.code, 0);
+  assert.equal(result.events.some(e => e.type === "training.terminated"), false);
+  assert.equal(f.calls.filter(c => c.url === "/v1/chat/completions").length, 1);
+});
