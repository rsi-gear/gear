{
  "name": "rsi-gear",
  "version": "0.2.0",
  "description": "Skill-first Gear refinement control plane with native DSH and harness-neutral adapters",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rsi-gear/gear.git"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "gear-hitch-codex": "./assets/hitch-codex-wrapper.mjs",
    "gear-dsh-runtime-check": "./assets/dsh-runtime-check.mjs",
    "gear": "./lib/cli.js",
    "gear-meta-codex": "./assets/codex-meta-runner.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./skill": {
      "types": "./lib/skill/index.d.ts",
      "default": "./lib/skill/index.js"
    },
    "./package.json": "./package.json",
    "./training": {
      "types": "./lib/training/index.d.ts",
      "default": "./lib/training/index.js"
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.json",
    "assets/ipython-kernel.py",
    "assets/llm-verifier-bridge.py",
    "assets/hitch-codex-wrapper.mjs",
    "assets/hitch-codex-credential-helper.mjs",
    "assets/dsh-runtime-check.mjs",
    "skills/refine/**",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "assets/python-policy-worker.cjs",
    "assets/gear-tool-fs.js",
    "assets/gear-tool-fs.d.ts",
    "assets/gear-tool-fs.LICENSE",
    "python/pyproject.toml",
    "python/setup.py",
    "python/patches/*.patch",
    "docs/training/README.zh-CN.md",
    "docs/training/controller-v2.zh-CN.md",
    "docs/training/stages.zh-CN.md",
    "docs/training/development.zh-CN.md",
    "docs/training/recipes.zh-CN.md",
    "docs/search-algorithm-authoring.zh-CN.md",
    "examples/training-loop/**",
    "docs/schemas/",
    "docs/generic-storage-implementation.zh-CN.md",
    "test-contracts/hitch-resources-v1.json",
    "python/gear/**/*.py",
    "python/gear/**/*.json",
    "python/gear/**/*.cjs",
    "python/gear/py.typed",
    "contracts/**",
    "docs/training/package-layout.zh-CN.md",
    "examples/algorithms/**",
    "assets/codex-meta-runner.mjs",
    "assets/codex-process-guard.py",
    "docs/codex-meta-runner.zh-CN.md",
    "docs/training/standalone-inference.md",
    "docs/training/standalone-inference.zh-CN.md",
    "docs/training/unattended-iteration.zh-CN.md",
    "docs/training/managed-native.zh-CN.md",
    "docs/unattended-model-iteration-design.zh-CN.md",
    "docs/validation/unattended-scheduler-controlled-2026-10-15.json"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "build": "npm run clean && npm run build:tool-fs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:api:package": "npm run build && node scripts/check-public-api-package.mjs",
    "test:unit": "vitest run tests/unit",
    "test:composition": "vitest run tests/composition",
    "test:sandbox:platform": "vitest run tests/integration/sandbox-platform.spec.ts tests/unit/sandbox.spec.ts tests/integration/python-worker.spec.ts tests/integration/codex-operation.spec.ts tests/integration/codex-guard.spec.ts tests/unit/codex-cleanup.spec.ts tests/unit/kernel-lock.spec.ts",
    "pack:check": "npm run build && npm pack --dry-run",
    "prepack": "npm run build",
    "build:tool-fs": "node scripts/build-private-tool-fs.mjs",
    "prepare": "npm run build:tool-fs",
    "test:training": "vitest run tests/unit/training && PYTHONPATH=python \"${GEAR_TRAINING_TEST_PYTHON:-python3}\" -m unittest discover -s python/tests -v",
    "generate:contracts": "python3 scripts/generate-algorithm-contracts.py",
    "lint": "eslint 'src/{domain,ports,runtime,application,adapters,cli}/**/*.ts'",
    "format:check": "prettier --check 'src/{domain,ports,runtime,application,adapters,cli}/**/*.ts'",
    "check:boundaries": "node scripts/check-boundaries.mjs && python3 scripts/check-python-boundaries.py",
    "check:contracts": "python3 scripts/generate-algorithm-contracts.py --check",
    "test:project:package": "npm run build && node scripts/check-project-package.mjs",
    "test:hitch:control": "npm run build && node scripts/check-hitch-control.mjs",
    "test:benchmark:llm": "npm run build && node scripts/check-llm-scorer.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.55",
    "@deepseek-ai/dsh-fs": "^0.1.0-rc.8 || ^0.1.1-rc.2",
    "@deepseek-ai/dsh-fs-local": "^0.1.0-rc.8 || ^0.1.1-rc.2",
    "@deepseek-ai/dsh-fs-observation-policy": "^0.1.0-rc.8 || ^0.1.1-rc.2",
    "@deepseek-ai/dsh-shell": "^0.1.0-rc.8 || ^0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "^0.1.0-rc.8 || ^0.1.1-rc.2",
    "@deepseek-ai/dsh-token-meter": "0.1.0-rc.8",
    "@deepseek-ai/dsh-tool-bash": "^0.1.0-rc.8 || ^0.1.1-rc.2",
    "@deepseek-ai/dsh-tool-fs-search": "^0.1.0-rc.8 || ^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "diff": "^8.0.2",
    "js-yaml": "^4.3.2",
    "typescript": "^6.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-include": "^1.0.6",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.8 || ^0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-presets": "^0.1.0-rc.8 || ^0.1.1-rc.2",
    "@deepseek-ai/dsh-attachment": "^0.1.0-rc.8 || ^0.1.1-rc.2",
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.8 || ^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.8 || ^0.1.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "^0.1.0-rc.8 || ^0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.8 || ^0.1.1-rc.2",
    "@deepseek-ai/dsh-skill": "^0.1.0-rc.8 || ^0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.8 || ^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.8 || ^0.1.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/cordis-plugin-include": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-presets": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    },
    "@deepseek-ai/dsh-sandbox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-include": "1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.8",
    "@deepseek-ai/dsh-agent-loop": "0.1.0-rc.8",
    "@deepseek-ai/dsh-agent-presets": "0.1.0-rc.8",
    "@deepseek-ai/dsh-attachment": "0.1.0-rc.8",
    "@deepseek-ai/dsh-commands": "0.1.0-rc.8",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.8",
    "@deepseek-ai/dsh-sandbox": "0.1.0-rc.8",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.8",
    "@deepseek-ai/dsh-session": "0.1.0-rc.8",
    "@deepseek-ai/dsh-session-persistence": "0.1.0-rc.8",
    "@deepseek-ai/dsh-skill": "0.1.0-rc.8",
    "@deepseek-ai/dsh-skill-filesystem": "0.1.0-rc.8",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.8",
    "@deepseek-ai/dsh-tool-skill": "0.1.0-rc.8",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.8",
    "@types/diff": "^7.0.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.19.0",
    "esbuild": "0.28.1",
    "eslint": "9.39.5",
    "gear-tool-fs-diff": "npm:diff@9.0.0",
    "prettier": "3.9.10",
    "typescript-eslint": "8.71.1",
    "vitest": "^4.1.8"
  }
}
