{
  "name": "gear-loop",
  "version": "1.0.0",
  "description": "Gear evolution loop — shared Remotion and standalone SVG animation",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.525",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.525"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.525",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "esbuild": "0.28.1",
    "@types/react-dom": "19.2.3"
  },
  "scripts": {
    "dev": "remotion studio --no-open",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "export:svg": "node scripts/export-svg.mjs",
    "still": "remotion still GearLoop out/gear-loop.png --frame=325",
    "still:architecture": "remotion still GearArchitecture out/gear-architecture.png --frame=300",
    "preview": "node scripts/preview-server.mjs"
  },
  "sideEffects": [
    "*.css"
  ]
}
